<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws its own SplashScreen instead of windowBackground.
         Red background plus the full adaptive icon (white plate + seal), so
         the cold start leads straight into the Flutter splash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/ebpco_primary_600</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>
