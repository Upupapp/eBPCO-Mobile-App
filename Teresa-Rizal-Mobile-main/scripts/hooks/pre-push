#!/bin/sh
# Pre-push gate for Teresa-Rizal-Mobile.
#
# There is no CI on this repository, so the local gate is the only gate, and
# /Users/user/CLAUDE.md's deploy protocol requires it before every push. This
# makes that mechanical instead of remembered.
#
# Runs the FULL suite, not the fast tier. tool/fast_test.dart says so itself:
# it is a per-save subset and explicitly not the gate. Cost measured on the
# macOS lane, warm: analyze ~4s, flutter test ~30-70s.
#
# To bypass: git push --no-verify. That is a protocol violation, not a
# shortcut — if you need it, say so in the push report.
set -e

APP_DIR="$(git rev-parse --show-toplevel)/Teresa-Mobile-App"
[ -d "$APP_DIR" ] || { echo "pre-push: $APP_DIR not found — is this the right repo?"; exit 1; }
cd "$APP_DIR"

command -v flutter >/dev/null 2>&1 || {
  echo "pre-push: flutter is not on PATH. Refusing to pass a gate that did not run."
  echo "          (A gate that cannot run must fail, not succeed quietly.)"
  exit 1
}

echo "pre-push: flutter analyze"
flutter analyze || { echo "pre-push: BLOCKED — analyze failed."; exit 1; }

echo "pre-push: flutter test"
flutter test || { echo "pre-push: BLOCKED — tests failed."; exit 1; }

echo "pre-push: OK"
