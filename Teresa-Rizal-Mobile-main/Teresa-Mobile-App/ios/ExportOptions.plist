<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- TestFlight build for the clickable demo. `app-store-connect` serves
	     TestFlight and the App Store alike; promotion needs no new build. -->
	<key>method</key>
	<string>app-store-connect</string>

	<!-- UPUP TECHNOLOGIES PTE. LTD owns ph.gov.teresarizal.teresaRizal
	     (owner decision 2026-09-25). Matches DEVELOPMENT_TEAM on every target. -->
	<key>teamID</key>
	<string>2K2SF7NRQP</string>

	<!-- Xcode fetches the distribution certificate and profile itself
	     (-allowProvisioningUpdates). No profiles are checked in. -->
	<key>signingStyle</key>
	<string>automatic</string>

	<key>uploadSymbols</key>
	<true/>

	<!-- `export` writes build/ios/ipa/*.ipa; the upload is a separate step. -->
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
